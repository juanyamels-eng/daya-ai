# ============================================
# DAYA IA — Frontend (plantilla)
# Copia este archivo como .env.local y rellena los valores.
# En Vercel estas mismas variables van en Settings → Environment Variables.
# ============================================

# URL pública del backend.
#  - En local:       http://localhost:4000
#  - En producción:  la URL que te da Railway
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL pública de ESTE frontend (SEO: Open Graph, robots, sitemap).
#  - En local:       http://localhost:3000
#  - En producción:  tu dominio de Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — necesario SOLO para el botón "Continuar con Google".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave para acceder al panel de administración (/admin).
# Déjalo vacío si no usas el panel admin.
NEXT_PUBLIC_ADMIN_KEY=

# Sentry (error tracking) — opcional, inerte por defecto.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/yyy
# NEXT_PUBLIC_SENTRY_DEBUG=1  (desactiva Sentry en dev para depurar)
