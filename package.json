{
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.5"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "knip": "knip --directory backend && knip --directory frontend && knip --directory cli"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "npx --prefix backend eslint --fix --config backend/eslint.config.mjs"
    ],
    "frontend/src/**/*.{ts,tsx,js,jsx}": [
      "npx --prefix frontend eslint --fix --config frontend/eslint.config.mjs"
    ]
  }
}
