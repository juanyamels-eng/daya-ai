# secretlint-disable
# ============================================
# DAYA IA — Variables de entorno (plantilla)
# Copia este archivo como .env y rellena los valores
# ============================================

# --- Base de datos (PostgreSQL) — OBLIGATORIO ---
DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# --- Seguridad — OBLIGATORIO ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_SECRET_KEY=tu-clave-secreta-de-admin
# Vigencia del token de sesión. Por defecto 3650d (sesión "infinita", diseño actual).
# Para mayor seguridad puedes acortarla, ej: JWT_EXPIRES_IN=90d  (opcional)
# JWT_EXPIRES_IN=3650d

# --- Acceso con Google (Supabase Auth) — opcional ---
# Necesario SOLO si activas el botón "Continuar con Google".
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- IA (OpenRouter) — necesario para chat y documentos ---
OPENROUTER_API_KEY=sk-or-v1-...
# Opcional — si no se define, usa https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM local (desarrollo) — opcional, permite usar Ollama en vez de OpenRouter ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5-coder:7b
# Modelos recomendados para Ollama (ejecuta `ollama pull <modelo>`):
#   qwen2.5-coder:7b     (mejor para código, 4.7GB)
#   qwen2.5:7b           (uso general, 4.7GB)
#   qwen2.5:14b          (más capaz, 9GB)
#   llama3.2:3b          (rápido y ligero, 2GB)
#   llama3.2:8b          (equilibrado, 4.7GB)
#   mistral:7b           (buen razonamiento, 4.1GB)
#   phi3:3.8b            (Microsoft, pequeño y capaz, 2.3GB)
#   gemma2:9b            (Google, 5.4GB)
#   deepseek-coder:6.7b  (especializado en código, 3.8GB)

# --- Embeddings — al menos uno de los dos ---
# OPENAI_API_KEY=sk-...  (necesario para embeddings de búsqueda semántica)
# GROQ_API_KEY=gsk_...   (transcripción de voz)

# --- Búsqueda web ---
TAVILY_API_KEY=tvly-...

# --- Generación de imágenes premium (fal.ai) — opcional ---
# Sin esto, la generación cae a Pollinations (gratis, sin key)
# FAL_KEY=...

# --- Imágenes de stock (Unsplash, Pexels) — opcional ---
# UNSPLASH_ACCESS_KEY=...
# PEXELS_API_KEY=...

# --- Emails (Resend) — opcional, sin esto los emails van a consola ---
RESEND_API_KEY=re_...
EMAIL_FROM=DAYA IA <onboarding@resend.dev>

# --- Cifrado de emails (IMAP) — opcional ---
# EMAIL_ENC_KEY=...  (clave de 32 hex para cifrar credenciales de correo)

# --- Pagos (PayPal) — opcional, sin esto los pagos están desactivados ---
PAYPAL_CLIENT_ID=PON-TU-CLIENT-ID
PAYPAL_SECRET=PON-TU-SECRET
# 'sandbox' para pruebas, 'live' para producción
PAYPAL_MODE=sandbox

# --- Pagos (Payoneer) — opcional ---
PAYONEER_PAYMENT_LINK=

# --- Webhook de pagos (opcional, recomendado en producción) ---
WEBHOOK_SECRET=

# --- Auto-mejora (selfimprove) — opcional, inerte por defecto ---
# Activa el loop que edita el repo, verifica y abre PRs (¡INVESTIGA ANTES de usar!).
# Requiere un clon del repo (DAYA_REPO_PATH) con el árbol de trabajo limpio y gh CLI autenticado.
# SELFIMPROVE_ENABLED=1
# DAYA_REPO_PATH=/ruta/al/clon/de/daya-ia
# SELFIMPROVE_WORKDIR=backend   (carpeta donde corre typecheck + tests)
# SELFIMPROVE_BRANCH=main      (rama base desde la que se crean las ramas de mejora)
# SELFIMPROVE_INTERVAL_H=6     (espaciado del intento automático del scheduler)

# --- URLs ---
FRONTEND_URL=http://localhost:3000
PORT=4000

# --- Caché distribuida (Redis) — opcional, sin esto el caché es in-memory ---
# REDIS_URL=redis://localhost:6379

# --- Entorno ---
NODE_ENV=development

# --- Sentry (error tracking) — opcional, inerte por defecto ---
# Si no se define, Sentry está desactivado y no hay overhead.
# SENTRY_DSN=https://xxx@sentry.io/yyy
# SENTRY_ALERT_WEBHOOK=https://hooks.slack.com/services/... (para alertas en tiempo real a Slack/Discord/PagerDuty)

# --- OpenTelemetry (tracing distribuido) — opcional ---
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_DEBUG=true

# --- Langfuse (eval de prompts, A/B tests, coste por usuario) — opcional ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
