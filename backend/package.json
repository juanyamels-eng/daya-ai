{
  "name": "daya-ia-backend",
  "version": "1.0.0",
  "description": "DAYA IA - Backend API",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "mcp": "ts-node --transpile-only src/mcp-stdio.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "postinstall": "prisma generate",
    "setup:browsers": "playwright install chromium",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings 345",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/compression": "^1.8.1",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "detect-secrets": "^1.0.6",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "imapflow": "^1.4.0",
    "ioredis": "^6.0.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "langfuse": "^3.38.20",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "msedge-tts": "^2.0.7",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "openai": "^4.24.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-png-converter": "^4.1.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.1.0",
    "qs": "^6.16.0",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.12",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npx eslint --fix"
    ],
    "*.{json,md}": "npx prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
